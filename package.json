{
  "name": "sapling-extension",
  "version": "1.4.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:content && npm run build:background",
    "build:content": "vite build -c vite.config.content.ts",
    "build:background": "vite build -c vite.config.background.ts",
    "dev": "npm run dev:content && npm run dev:background",
    "dev:content": "npm run build:content -- --watch",
    "dev:background": "npm run build:background -- --watch",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/webextension-polyfill": "^0.12.4",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^9.12.0",
    "jiti": "^2.6.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.52.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  }
}
