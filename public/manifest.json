{
  "manifest_version": 2,
  "name": "Sapling Navigator",
  "version": "1.0",
  "description": "Add experience improvement features to Sapling and ghstack pull requests",
  "permissions": ["https://github.com/*"],
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*/pull/*",
        "https://github.com/*/pull/*/checks",
        "https://github.com/*/pull/*/commits",
        "https://github.com/*/pull/*/files"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
